<h1>Baskets#index</h1>

<table>
  <% if @baskets.present? %>
    <tr>
      <th>商品画像</th>
      <th>商品名</th>
      <th>購入数</th>
      <th>購入期限</th>
      <th>✅</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
    <% @baskets.each do |basket| %>
    <tr>
      <td>
        <%= image_tag("#{basket.product_image}") %>
      </td>
      <td>
        <%= basket.product_name %>
      </td>
      <td>
        <%= basket.product_qty %>
      </td>
      <td>
        <%= basket.due_date.strftime("%Y/%m/%d") %>
      </td>
      <td>
        <% if basket.purchase.present? %>
          <%= link_to "購入済み", "#" %>
        <% else %>
          <%= link_to "購入済みにする", basket_path(basket) %>
        <% end %>
      </td>
      <td>
        <% unless basket.purchase.present? %>
          <%= link_to "購入予定の編集", edit_basket_path(basket) %>
        <% end %>
      </td>
      <td>
        <% if user_signed_in? && current_user.id == basket.user_id %>
          <%= link_to "削除", basket_path(basket), method: :delete, data: {confirm: "アイテムを削除しますか？"} %>
        <% end %>
      </td>
    </tr>
    <% end %>
  <% else %>
    買い物リストに購入予定の商品はありません
  <% end %>
</table>
