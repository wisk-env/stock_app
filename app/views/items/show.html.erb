<h1>商品を追加する Items#show </h1>

<%= form_with(model: @stock, local: true) do |f| %>
  <div>
    <%= f.label :stock_name, "ストック名" %>
    <%= f.text_area :stock_name, value: @item.item_name %>
  </div>
  <div>
    <%= f.label :stock_qty, "ストック数" %>
    <%= f.number_field :stock_qty, value: 1, in: 1..100 %>
  </div>
  <div>
    <%= f.label :category, "商品カテゴリー" %>
    <%= f.text_field :category, value: @item.item_genre %>
  </div>
  <div>
    <%= f.label :name, "商品タグ" %>
    <%= f.text_field :name, class: "text_field" %>
  </div>
  <div>
    <%= f.label :note, "メモ" %>
    <%= f.text_area :note, wrap: "soft" %>
  </div>
  <div>
    <%= f.label :stock_image, "商品画像" %>
    <%= f.hidden_field :stock_image, value: @item.item_image %>
    <%= image_tag("#{@item.item_image}") %>
  </div>
  <div>
    <%= f.hidden_field :user_id, value: current_user.id %>
    <%= f.hidden_field :item_id, value: @item.id %>
  </div>
  <div>
    <%= link_to "キャンセル", 'javascript:history.back()' %>
    <%= f.submit "商品を追加" %>
  </div>
<% end %>
