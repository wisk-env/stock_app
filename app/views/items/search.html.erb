<h1>Items#search</h1>
<h1>アイテム名を入力して検索</h1>

<div>
  <%= form_with url: items_search_path, method: :get, local: true do |f| %>
    <div>
      <%= f.text_field :keyword, value: params[:keyword] %>
      <%= f.submit '製品を検索' %>
    </div>
  <% end %>
  <% if @items.present? %>
    <% @items.first(10).each do |item| %>
      <div>
        <%= form_with(model: @item, local: true) do |f| %>        
          <% if item.medium_image_url.present? %>
            <%= image_tag("#{item.medium_image_url}") %>
          <% else %>
            画像なし
          <% end %>
          <%= link_to item.name, "#{item.url_pc}" %>
          <%= item.genre_name %>
          <%= text_field_tag "item_name", "#{item.name}" %>
          <%= f.hidden_field :item_name, value: item.name %>
          <%= f.hidden_field :item_image, value: item.medium_image_url %>
          <%= f.hidden_field :item_genre, value: item.genre_name %>
          <%= f.hidden_field :item_url_pc, value: item.url_pc %>
          <%= f.hidden_field :item_url_mobile, value: item.url_mobile %>
          <%= f.submit "この商品を追加する" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
