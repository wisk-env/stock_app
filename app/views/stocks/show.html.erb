<h1>Stocks#show</h1>
  <div>
    商品名：
    <%= @stock.stock_name %>
  </div>
  <div>
    ストック数；
    <%= @stock.stock_qty %>
  </div>
  <div>
    メモ：
    <%= @stock.note %>
  </div>
  <div>
    商品画像：
    <%= image_tag("#{@stock.stock_image}") %>
  </div>
  <div>
    編集：
    <%= link_to "編集", edit_stock_path(@stock) %>
  </div>
  <div>
    削除：
    <%= link_to "削除", stock_path(@stock), method: :delete, data: {confirm: "削除しますか？"} %>
  </div>
