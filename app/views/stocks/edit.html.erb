<h1>商品を編集する Stocks#edit </h1>

<%= form_with(model: @stock, local: true) do |f| %>
  <div>
    <%= f.label :stock_name, "ストック名" %>
    <%= f.text_area :stock_name, value: @stock.stock_name %>
  </div>
  <div>
    <%= f.label :stock_qty, "ストック数" %>
    <%= f.number_field :stock_qty, value: @stock.stock_qty, in: 1..100 %>
  </div>
  <div>
    <%= f.label :category, "商品カテゴリー" %>
    <%= f.text_field :category, value: @stock.category %>
  </div>
  <div>
    <%= f.label :note, "メモ" %>
    <%= f.text_area :note, value: @stock.note %>
  </div>
  <div>
    <%= f.label :stock_image, "商品画像" %>
    <%= f.hidden_field :stock_image, value: @stock.stock_image %>
    <%= image_tag("#{@stock.stock_image}") %>
  </div>
  <div>
    <%= f.hidden_field :user_id, value: current_user.id %>
    <%= f.hidden_field :item_id, value: @stock.item_id %>
  </div>
  <div>
    <%= link_to "キャンセル", :stocks %>
    <%= f.submit "商品を更新" %>
  </div>
<% end %>
