<h1>ストック検索</h1>
<%= search_form_for @q, url: search_stocks_path do |f| %>
  <%= f.label :stock_name_cont, 'キーワード検索' %>
  <%= f.search_field :stock_name_or_category_or_note_cont %>
  <br>
  <%= f.label :category_eq, 'カテゴリー' %>
  <% @stock_categories.each do |stock_category| %>
    <%= f.check_box :category_eq_any, { multiple: true, include_hidden: false }, stock_category[:category] %>
    <%= stock_category.category %>
  <% end %>
  <br>
  <%= f.label :tags_name_eq, "タグ" %>
  <% @tag_lists.each do |tag| %>
    <%= f.check_box :tags_name_eq_any, { multiple: true, include_hidden: false }, tag[:name] %>
    <%= tag.name %>
  <% end %>
  <br>
  <%= f.submit '検索' %>
<% end %>

<h1>ストック一覧 Stocks#index</h1>
<% @stocks.each do |stock| %>
  <div>
    ストック名：
    <%= stock.stock_name %>
  </div>
  <div>
    ストック数：
    <%= stock.stock_qty %>
  </div>
  <div>
    ストック期限：
    <%= stock.start_time.strftime("%Y/%m/%d") %>
    <% if (stock.start_time.end_of_day - Time.current).to_i / 1.day > 0 %>
      <%= "(期限まであと #{ (stock.start_time.end_of_day - Time.current).to_i / 1.day } 日です)" %>
    <% elsif (stock.start_time.end_of_day - Time.current).to_i / 1.day == 0 %>
      <%= "(今日が期限です)" %>
    <% else %>
      <%= "(期限が切れています)" %>
    <% end %>
  </div>
  <div>
    カテゴリー：
    <%= stock.category %>
  </div>
  <div>
    メモ：
    <%= stock.note %>
  </div>
  <div>
    商品画像：
    <%= image_tag("#{stock.stock_image}") %>
  </div>
  <div>
    商品タグ：
    <% stock.tags.each do |stock_tag| %>
      <%= link_to stock_tag.name, "#", class: "btn" %>
    <% end %>
  </div>
  <div>
    詳細：
    <%= link_to "詳細", stock_path(stock) %>
  </div>
  <% if user_signed_in? && current_user.id == stock.user_id %>
    <div>
      編集：
      <%= link_to "編集", edit_stock_path(stock) %>
    </div>
    <div>
      削除：
        <%= link_to "削除", stock_path(stock), method: :delete, data: {confirm: "削除しますか？"} %>
    </div>
  <% end %>
<% end %>
